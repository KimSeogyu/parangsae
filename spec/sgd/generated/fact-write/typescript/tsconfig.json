{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "types": []
  },
  "include": [
    "machine.ts", "primitive.ts"
  ]
}
