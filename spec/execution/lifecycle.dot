digraph OrderLifecycleCells {
 rankdir=LR; node [shape=box, fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=9];
 "IllegalTransition" [label="IllegalTransition\n(order unchanged; halt + alert)", color=red, fontcolor=red];
 "PendingNew" -> "Acked" [label="Ack"];
 "PendingNew" -> "Filled" [label="Fill"];
 "PendingNew" -> "PartiallyFilled" [label="Fill"];
 "PendingNew" -> "PendingCancel" [label="CancelRequested"];
 "PendingNew" -> "IllegalTransition" [label="CancelDenied", color=red, fontcolor=red];
 "PendingNew" -> "Rejected" [label="Reject"];
 "PendingNew" -> "Expired" [label="Expire"];
 "PendingNew" -> "Unknown" [label="Timeout"];
 "Acked" -> "Acked" [label="Ack"];
 "Acked" -> "Filled" [label="Fill"];
 "Acked" -> "PartiallyFilled" [label="Fill"];
 "Acked" -> "PendingCancel" [label="CancelRequested"];
 "Acked" -> "IllegalTransition" [label="Reject", color=red, fontcolor=red];
 "Acked" -> "Expired" [label="Expire"];
 "Acked" -> "Unknown" [label="Timeout"];
 "PartiallyFilled" -> "PartiallyFilled" [label="Ack"];
 "PartiallyFilled" -> "Filled" [label="Fill"];
 "PartiallyFilled" -> "PartiallyFilled" [label="Fill (unreached)", style=dashed, color=grey, fontcolor=grey];
 "PartiallyFilled" -> "PendingCancel" [label="CancelRequested"];
 "PartiallyFilled" -> "Expired" [label="Expire"];
 "PartiallyFilled" -> "Unknown" [label="Timeout"];
 "Filled" -> "IllegalTransition" [label="Ack", color=red, fontcolor=red];
 "Filled" -> "IllegalTransition" [label="CancelDenied", color=red, fontcolor=red];
 "PendingCancel" -> "PendingCancel" [label="Ack"];
 "PendingCancel" -> "Filled" [label="Fill"];
 "PendingCancel" -> "PendingCancel" [label="Fill"];
 "PendingCancel" -> "PendingCancel" [label="CancelRequested (unreached)", style=dashed, color=grey, fontcolor=grey];
 "PendingCancel" -> "Acked" [label="CancelDenied"];
 "PendingCancel" -> "PartiallyFilled" [label="CancelDenied"];
 "PendingCancel" -> "Canceled" [label="CancelConfirmed"];
 "PendingCancel" -> "IllegalTransition" [label="Reject", color=red, fontcolor=red];
 "PendingCancel" -> "Expired" [label="Expire"];
 "PendingCancel" -> "Unknown" [label="Timeout"];
 "Canceled" -> "IllegalTransition" [label="Ack", color=red, fontcolor=red];
 "Canceled" -> "IllegalTransition" [label="CancelConfirmed", color=red, fontcolor=red];
 "Canceled" -> "Canceled" [label="RaceFill"];
 "Rejected" -> "IllegalTransition" [label="CancelDenied", color=red, fontcolor=red];
 "Expired" -> "IllegalTransition" [label="Ack", color=red, fontcolor=red];
 "Expired" -> "IllegalTransition" [label="CancelDenied", color=red, fontcolor=red];
 "Unknown" -> "IllegalTransition" [label="Ack", color=red, fontcolor=red];
 "Unknown" -> "IllegalTransition" [label="Fill", color=red, fontcolor=red];
 "Unknown" -> "Unknown" [label="CancelRequested"];
 "Unknown" -> "IllegalTransition" [label="CancelDenied", color=red, fontcolor=red];
 "Unknown" -> "IllegalTransition" [label="CancelConfirmed", color=red, fontcolor=red];
 "Unknown" -> "IllegalTransition" [label="Reject", color=red, fontcolor=red];
 "Unknown" -> "IllegalTransition" [label="Expire", color=red, fontcolor=red];
 "Unknown" -> "Unknown" [label="Timeout"];
 "Unknown" -> "Filled" [label="QueryFilled"];
 "Unknown" -> "Canceled" [label="QueryCanceled"];
 "Unknown" -> "PendingNew" [label="QueryNotFound"];
}
