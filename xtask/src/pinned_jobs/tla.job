  tla:
    name: tla
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@5059963b1731bf1580991b5f3b1eecfb5da406c0 # 1.98.0
      - name: cargo and rustc are the 1.98.0 toolchain
        run: |
          cargo_bin="$(rustup which cargo)"
          rustc_bin="$(rustup which rustc)"
          if [ "$cargo_bin" != "/home/runner/.rustup/toolchains/1.98.0-x86_64-unknown-linux-gnu/bin/cargo" ]; then
            echo "cargo is ${cargo_bin}"
            exit 1
          fi
          if [ "$rustc_bin" != "/home/runner/.rustup/toolchains/1.98.0-x86_64-unknown-linux-gnu/bin/rustc" ]; then
            echo "rustc is ${rustc_bin}"
            exit 1
          fi
      - name: rustc is 1.98.0
        run: |
          expected="rustc 1.98.0 (88d9e12ae 2026-08-18)"
          actual="$(rustc -V)"
          if [ "$actual" != "$expected" ]; then
            echo "rustc -V was ${actual}"
            exit 1
          fi
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: "21"
      - name: Fetch TLC 2.19 (TLA+ 1.7.4)
        run: |
          cd specs/tla
          curl -fsSL -o tla2tools.jar -L \
            https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
          echo "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88  tla2tools.jar" | sha256sum -c -
      - name: Model-check IngestSegment
        # One worker: TLC 2.19 can miss a liveness counterexample with several workers.
        # A violated invariant or property makes TLC exit non-zero.
        run: |
          cd specs/tla
          set -o pipefail
          java -XX:+UseParallelGC -Xmx512m -cp tla2tools.jar tlc2.TLC \
            -workers 1 \
            -metadir "${{ runner.temp }}/tlc-ingest" \
            -config IngestSegment.cfg \
            IngestSegment.tla | tee "${{ runner.temp }}/tlc-ingest.txt"
      - name: Check IngestSegment TLC output
        run: |
          cd "$GITHUB_WORKSPACE"
          cargo xtask guards tlc-output --model IngestSegment --file "${{ runner.temp }}/tlc-ingest.txt"
      - name: Model-check ManifestWrite
        run: |
          cd specs/tla
          set -o pipefail
          java -XX:+UseParallelGC -Xmx512m -cp tla2tools.jar tlc2.TLC \
            -workers 1 \
            -metadir "${{ runner.temp }}/tlc-manifest" \
            -config ManifestWrite.cfg \
            ManifestWrite.tla | tee "${{ runner.temp }}/tlc-manifest.txt"
      - name: Check ManifestWrite TLC output
        run: |
          cd "$GITHUB_WORKSPACE"
          cargo xtask guards tlc-output --model ManifestWrite --file "${{ runner.temp }}/tlc-manifest.txt"

