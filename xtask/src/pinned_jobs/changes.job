  changes:
    name: changes
    runs-on: [self-hosted, linux, x64, parangsae]
    outputs:
      kani: ${{ steps.filter.outputs.kani }}
      tla: ${{ steps.filter.outputs.tla }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
      - name: Decide which path-gated jobs run
        id: filter
        # Fail-safe: when no base can be determined, both kani and tla run.
        env:
          EVENT_NAME: ${{ github.event_name }}
          PUSH_BEFORE: ${{ github.event.before }}
          PR_BASE: ${{ github.event.pull_request.base.sha }}
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: |
          set -euo pipefail
          head=$(git rev-parse HEAD)
          base=""
          if [ "$EVENT_NAME" = "pull_request" ] && [ -n "$PR_BASE" ]; then
            base="$PR_BASE"
          elif [ "$EVENT_NAME" = "push" ] && [ -n "$PUSH_BEFORE" ] \
              && [ "$PUSH_BEFORE" != "0000000000000000000000000000000000000000" ] \
              && git cat-file -e "${PUSH_BEFORE}^{commit}" 2>/dev/null \
              && git merge-base --is-ancestor "$PUSH_BEFORE" "$head"; then
            base="$PUSH_BEFORE"
          elif [ "$EVENT_NAME" = "push" ] && [ -n "$DEFAULT_BRANCH" ]; then
            # New branch (before is all zeros) or force push: diff against the default branch.
            base=$(git merge-base "origin/$DEFAULT_BRANCH" "$head" 2>/dev/null || true)
          fi
          if [ -z "$base" ] || ! git cat-file -e "${base}^{commit}" 2>/dev/null; then
            echo "No usable diff base; running kani and tla."
            echo "kani=true" >> "$GITHUB_OUTPUT"
            echo "tla=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          echo "Diff base: $base  head: $head"
          git diff --name-only "$base" "$head" > "$RUNNER_TEMP/changed.txt"
          cat "$RUNNER_TEMP/changed.txt"
          # Crates whose src/ holds a Kani harness (at base or head).
          kani_crates=$( { git grep -l -E 'kani::proof' "$head" -- 'crates/*/src/**' || true
                           git grep -l -E 'kani::proof' "$base" -- 'crates/*/src/**' || true; } \
                         | sed -E 's#^[0-9a-f]+:crates/([^/]+)/.*#\1#' | sort -u)
          echo "Crates with Kani harnesses: ${kani_crates:-none}"
          kani_re='cfg\((any\()?[^)]*kani|cfg_attr\(kani|kani::'
          mentions_kani() {
            {
              git show "$head:$1" 2>/dev/null || true
              git show "$base:$1" 2>/dev/null || true
            } > "$RUNNER_TEMP/kani-mention.txt"
            grep -qE "$kani_re" "$RUNNER_TEMP/kani-mention.txt"
          }
          kani=false
          tla=false
          while IFS= read -r f; do
            [ -n "$f" ] || continue
            case "$f" in
              .github/workflows/*) kani=true; tla=true ;;
            esac
            case "$f" in
              specs/tla/*) tla=true ;;
            esac
            case "$f" in
              crates/*/src/*)
                c=$(printf '%s\n' "$f" | cut -d/ -f2)
                matched=false
                for name in $kani_crates; do
                  if [ "$name" = "$c" ]; then
                    matched=true
                  fi
                done
                if [ "$matched" = true ]; then kani=true; fi ;;
            esac
            case "$f" in
              Cargo.toml|rust-toolchain|rust-toolchain.toml|*kani*) kani=true ;;
              crates/*/Cargo.toml)
                if mentions_kani "$f"; then
                  kani=true
                else
                  git show "$head:$f" > "$RUNNER_TEMP/kani-manifest.txt" 2>/dev/null || true
                  if grep -q kani "$RUNNER_TEMP/kani-manifest.txt"; then kani=true; fi
                fi ;;
            esac
            case "$f" in
              *.rs) if mentions_kani "$f"; then kani=true; fi ;;
            esac
          done < "$RUNNER_TEMP/changed.txt"
          echo "kani=$kani tla=$tla"
          echo "kani=$kani" >> "$GITHUB_OUTPUT"
          echo "tla=$tla" >> "$GITHUB_OUTPUT"

